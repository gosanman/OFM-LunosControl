          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage Id="%FILE-kwlboard2%" Name="kwlboard-2.png" TargetPath="">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage Id="%FILE-kwlboard4%" Name="kwlboard-4.png" TargetPath="">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
