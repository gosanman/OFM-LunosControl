<?xml version="1.0" encoding="utf-8"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">

  <op:minOpenKNXproducerVersion value="4.3.9" />

  <!-- ===================================================================================
       Modul FAN - geraeteweite Parameter (Hardwareauswahl, Verbuende, Status-LEDs).

       Dieses share.xml traegt zusaetzlich das Geruest des Produkts (Catalog, Code-Segment,
       Hardware) UND den einzigen Wurzelknoten der Applikation. Beide eigenen Module haengen
       darin: Raum- und Luefterseiten sollen in der ETS als eine Einheit erscheinen, und
       Channel-in-Channel verbietet der Producer. Deshalb spannt nur FAN einen <Channel> auf
       und holt die Raumseiten per op:include mit prefix="ROOM" herein; Room.share.xml
       liefert nur <Static>. Die KO-Nummern bleiben davon unberuehrt - sie kommen aus dem
       op:define des jeweiligen Moduls, nicht aus dem Baum.

       Preis dieser Loesung: im Auswahlfeld des Konfigurationstransfers heisst das Raummodul
       roh "ROOM" statt "Raeume" (der Klartext kaeme aus einem eigenen <Channel Text=...>),
       und auf der BASE-Seite "Module" gibt es nur noch einen Schalter fuer beide.

       Geraeteweites Speicherbild dieses Moduls:
         Offset 0     Hardware      (Enum, Wert = Kanalzahl)
         Offset 1     StartupDelay
         Offset 2     GroupCount
         Offset 3     Reserve
         Offset 4..   8 Verbuende a 20 Byte (Fan.group.part.xml) -> 4..163
       =================================================================================== -->

  <ManufacturerData>
    <Manufacturer RefId="M-00FA">
      <Catalog>
        <CatalogSection Id="M-00FA_CS-1" Name="Geräte" Number="1" DefaultLanguage="de">
          <CatalogItem Id="%CatalogItemId%" Name="KwlControl" Number="1" ProductRefId="%ProductId%" Hardware2ProgramRefId="%Hardware2ProgramId%" DefaultLanguage="de" />
        </CatalogSection>
      </Catalog>
      <ApplicationPrograms>
        <ApplicationProgram Id="%AID%" ApplicationNumber="1" ApplicationVersion="1" ReplacesVersions="0" ProgramType="ApplicationProgram" MaskVersion="MV-07B0" Name="KwlControl" LoadProcedureStyle="MergedProcedure" PeiType="0" DefaultLanguage="de" DynamicTableManagement="false" Linkable="true" MinEtsVersion="5.0">

          <!-- Acht Verbuende aus einem Baustein. GrpOffset springt um die Blockgroesse 20,
               GGG um 20 Id-Plaetze (100..253), Gn zaehlt die Verbundnummer. -->
          <op:part name="GROUP" href="Fan.group.part.xml" instances="8">
            <op:param name="%GrpOffset%" value="4" increment="20" />
            <op:param name="%GGG%" value="100" digits="3" increment="20" />
            <op:param name="%Gn%" value="1" increment="1" />
          </op:part>

          <Static>
            <Code>
              <RelativeSegment Id="%AID%_RS-04-00000" Name="Parameters" Offset="0" Size="%MemorySize%" LoadStateMachine="4" />
            </Code>
            <ParameterTypes>

              <!-- ===== Hardwareauswahl =====
                   Der Enum-WERT ist die Kanalzahl. Damit wird die Sichtbarkeit einer
                   Luefterseite zu einem schlichten Zahlenvergleich (Kanalnummer <=
                   Hardware), und die Firmware liest denselben Parameter als Zahl und
                   vergleicht ihn mit FANDRV_BOARD_CHANNELS aus dem Board-Header. -->
              <ParameterType Id="%AID%_PT-FanHardware" Name="FanHardware">
                <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                  <Enumeration Text="Entwicklungsaufbau Pico + DFR1073 (2 Kanäle)" Value="2" Id="%ENID%" Icon="kwlhw-2" />
                  <Enumeration Text="KNXFANDRV Rev 0.1 (4 Kanäle)" Value="4" Id="%ENID%" Icon="kwlhw-4" />
                  <Enumeration Text="KNXFANDRV 6 (6 Kanäle)" Value="6" Id="%ENID%" Icon="kwlhw-6" />
                  <Enumeration Text="KNXFANDRV 8 (8 Kanäle)" Value="8" Id="%ENID%" Icon="kwlhw-8" />
                  <Enumeration Text="KNXFANDRV 10 (10 Kanäle)" Value="10" Id="%ENID%" Icon="kwlhw-10" />
                  <Enumeration Text="KNXFANDRV 12 (12 Kanäle)" Value="12" Id="%ENID%" Icon="kwlhw-12" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanStartupDelay" Name="FanStartupDelay">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="30" />
              </ParameterType>
              <!-- Klemme bzw. DAC-Ausgang, an dem dieser Luefter haengt. Vorgabe je Kanal
                   ist die eigene Kanalnummer (Value="%C%" - der Producer setzt sie ein),
                   also Luefter n an Kanal n. Wer anders verdrahtet hat, stellt es um. -->
              <!-- Klemmenbilder. Muster aus Common.share.xml (PT-ETS): ein Bild ist ein
                   Parametertyp TypePicture, der auf eine Baggage-Datei zeigt, plus ein
                   Parameter mit Access="Read", der nichts speichert und nur angezeigt wird. -->
              <ParameterType Id="%AID%_PT-BoardPic2" Name="BoardPic2">
                <TypePicture RefId="%FILE-kwlboard2%" HorizontalAlignment="Left" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-BoardPic4" Name="BoardPic4">
                <TypePicture RefId="%FILE-kwlboard4%" HorizontalAlignment="Left" />
              </ParameterType>

              <ParameterType Id="%AID%_PT-FanDacChannel" Name="FanDacChannel">
                <TypeNumber SizeInBit="4" Type="unsignedInt" minInclusive="1" maxInclusive="12" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanGroupCount" Name="FanGroupCount">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="8" />
              </ParameterType>

              <!-- ===== Verbund ===== -->
              <ParameterType Id="%AID%_PT-FanGrpRole" Name="FanGrpRole">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="intern (nur Lüfter dieses Geräts)" Value="0" Id="%ENID%" />
                  <Enumeration Text="Master — sendet auf den Bus" Value="1" Id="%ENID%" />
                  <Enumeration Text="Slave — folgt externem Master" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanGrpStageRule" Name="FanGrpStageRule">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="Maximum, begrenzt durch kleinsten Raumdeckel" Value="0" Id="%ENID%" />
                  <Enumeration Text="Minimum" Value="1" Id="%ENID%" />
                  <Enumeration Text="ein Raum führt" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanGrpCycleRule" Name="FanGrpCycleRule">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Wärmerückgewinnung gewinnt (kürzester Zyklus)" Value="0" Id="%ENID%" />
                  <Enumeration Text="der führende Raum entscheidet" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanRoomNo" Name="FanRoomNo">
                <TypeNumber SizeInBit="4" Type="unsignedInt" minInclusive="1" maxInclusive="8" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanRoomNo0" Name="FanRoomNo0">
                <TypeNumber SizeInBit="4" Type="unsignedInt" minInclusive="0" maxInclusive="8" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanDeadTime" Name="FanDeadTime">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="10" />
              </ParameterType>
              <!-- 40 s .. 2 h in Sekunden. Eine Einheit statt Wert+Einheit-Paar: der ganze
                   interessante Bereich liegt zwischen 40 und 3600, und ein zweites
                   Auswahlfeld je Stufe waeren vier Klicks fuer nichts. -->
              <ParameterType Id="%AID%_PT-FanCycleTime" Name="FanCycleTime">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="40" maxInclusive="7200" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanHeartbeat" Name="FanHeartbeat">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="10" maxInclusive="600" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanMasterTimeout" Name="FanMasterTimeout">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="30" maxInclusive="1800" />
              </ParameterType>

              <!-- ===== Luefterkanal (Fan.templ.xml) ===== -->
              <ParameterType Id="%AID%_PT-FanChannelActive" Name="FanChannelActive">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
                  <Enumeration Text="Aktiviert" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanType" Name="FanType">
                <TypeRestriction Base="Value" SizeInBit="3">
                  <Enumeration Text="LUNOS e²60" Value="0" Id="%ENID%" />
                  <Enumeration Text="LUNOS ego (belegt 2 Kanäle)" Value="1" Id="%ENID%" />
                  <Enumeration Text="LUNOS RA 15-60 (unipolar)" Value="2" Id="%ENID%" />
                  <Enumeration Text="generisch bipolar (um 5 V)" Value="3" Id="%ENID%" />
                  <Enumeration Text="generisch unipolar (0–10 V)" Value="4" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanGroupNo" Name="FanGroupNo">
                <TypeRestriction Base="Value" SizeInBit="4">
                  <Enumeration Text="eigenständig (eigener Takt)" Value="0" Id="%ENID%" />
                  <Enumeration Text="Verbund 1" Value="1" Id="%ENID%" />
                  <Enumeration Text="Verbund 2" Value="2" Id="%ENID%" />
                  <Enumeration Text="Verbund 3" Value="3" Id="%ENID%" />
                  <Enumeration Text="Verbund 4" Value="4" Id="%ENID%" />
                  <Enumeration Text="Verbund 5" Value="5" Id="%ENID%" />
                  <Enumeration Text="Verbund 6" Value="6" Id="%ENID%" />
                  <Enumeration Text="Verbund 7" Value="7" Id="%ENID%" />
                  <Enumeration Text="Verbund 8" Value="8" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanPhase" Name="FanPhase">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Phase A" Value="0" Id="%ENID%" />
                  <Enumeration Text="Phase B (gegenläufig)" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanShare" Name="FanShare">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="25" maxInclusive="100" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanDirection5V" Name="FanDirection5V">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="unter 5 V = Zuluft" Value="0" Id="%ENID%" />
                  <Enumeration Text="unter 5 V = Abluft" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanMilliVolt" Name="FanMilliVolt">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="10000" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanFlow" Name="FanFlow">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="100" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanCurrent" Name="FanCurrent">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="1000" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanCableLength" Name="FanCableLength">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="30" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanCableSection" Name="FanCableSection">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="0,5 mm²" Value="0" Id="%ENID%" />
                  <Enumeration Text="0,7 mm²" Value="1" Id="%ENID%" />
                  <Enumeration Text="1,0 mm²" Value="2" Id="%ENID%" />
                  <Enumeration Text="1,5 mm²" Value="3" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanCableResistance" Name="FanCableResistance">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="2000" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanCalibGain" Name="FanCalibGain">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="9800" maxInclusive="10200" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanFilterMode" Name="FanFilterMode">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="aus" Value="0" Id="%ENID%" />
                  <Enumeration Text="nach Laufzeit" Value="1" Id="%ENID%" />
                  <Enumeration Text="nach durchgesetzter Luftmenge" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanFilterHours" Name="FanFilterHours">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="500" maxInclusive="8760" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanFilterVolume" Name="FanFilterVolume">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="10" maxInclusive="500" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanFilterRemind" Name="FanFilterRemind">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="72" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanPowerOnStage" Name="FanPowerOnStage">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="Stillstand" Value="0" Id="%ENID%" />
                  <Enumeration Text="Stufe 1 (Feuchteschutz)" Value="1" Id="%ENID%" />
                  <Enumeration Text="Stufe 2" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanSendCycleMin" Name="FanSendCycleMin">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="1440" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanSendCycleHour" Name="FanSendCycleHour">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="24" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-FanYesNo" Name="FanYesNo">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Nein" Value="0" Id="%ENID%" />
                  <Enumeration Text="Ja" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>

              <!-- Status-LEDs. Gleiche Id wie der Typ in Common.share.xml: der Producer
                   fuehrt die Enumerationen zusammen, sodass unsere Kanaele zusaetzlich zu
                   den Eintraegen von BASE in den Info-LED-Dropdowns erscheinen. Deshalb hier
                   nur die eigenen Werte und op:headerExport="none" - der Typ gehoert BASE.
                   Die Werte muessen zur Basis 110 in KwlTypes.h passen. -->
              <ParameterType Id="%AID%_PT-SLEDFunc" Name="SLEDFunc" op:headerExport="none">
                <TypeRestriction Base="Value" SizeInBit="16" UIHint="DropDown">
                  <Enumeration Text="Lüfter 1" Value="110" Id="%ENID%" />
                  <Enumeration Text="Lüfter 2" Value="111" Id="%ENID%" />
                  <Enumeration Text="Lüfter 3" Value="112" Id="%ENID%" />
                  <Enumeration Text="Lüfter 4" Value="113" Id="%ENID%" />
                  <Enumeration Text="Lüfter 5" Value="114" Id="%ENID%" />
                  <Enumeration Text="Lüfter 6" Value="115" Id="%ENID%" />
                  <Enumeration Text="Lüfter 7" Value="116" Id="%ENID%" />
                  <Enumeration Text="Lüfter 8" Value="117" Id="%ENID%" />
                  <Enumeration Text="Lüfter 9" Value="118" Id="%ENID%" />
                  <Enumeration Text="Lüfter 10" Value="119" Id="%ENID%" />
                  <Enumeration Text="Lüfter 11" Value="120" Id="%ENID%" />
                  <Enumeration Text="Lüfter 12" Value="121" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>

            </ParameterTypes>
            <Parameters>
              <Union SizeInBit="24">
                <Memory CodeSegment="%AID%_RS-04-00000" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00001" Name="Hardware" Offset="0" BitOffset="0" ParameterType="%AID%_PT-FanHardware" Text="Platine" Value="4" />
                <Parameter Id="%AID%_UP-%TT%00002" Name="StartupDelay" Offset="1" BitOffset="0" ParameterType="%AID%_PT-FanStartupDelay" Text="Wartezeit nach Busspannungswiederkehr" SuffixText=" s" Value="3" />
                <Parameter Id="%AID%_UP-%TT%00003" Name="GroupCount" Offset="2" BitOffset="0" ParameterType="%AID%_PT-FanGroupCount" Text="Anzahl der Verbünde" Value="2" />
              </Union>
              <Parameter Id="%AID%_P-%TT%00010" Name="BoardPic2" ParameterType="%AID%_PT-BoardPic2" Text="" Access="Read" Value="" />
              <Parameter Id="%AID%_P-%TT%00011" Name="BoardPic4" ParameterType="%AID%_PT-BoardPic4" Text="" Access="Read" Value="" />
              <!-- Offset 3 Reserve, ab Offset 4 die Verbuende -->
              <op:usePart name="GROUP" xpath="//Static/Parameters/*" />
            </Parameters>
            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" />
              <ParameterRef Id="%AID%_UP-%TT%00002_R-%TT%0000201" RefId="%AID%_UP-%TT%00002" />
              <ParameterRef Id="%AID%_UP-%TT%00003_R-%TT%0000301" RefId="%AID%_UP-%TT%00003" />
              <ParameterRef Id="%AID%_P-%TT%00010_R-%TT%0001001" RefId="%AID%_P-%TT%00010" />
              <ParameterRef Id="%AID%_P-%TT%00011_R-%TT%0001101" RefId="%AID%_P-%TT%00011" />
              <op:usePart name="GROUP" xpath="//Static/ParameterRefs/*" />
            </ParameterRefs>
            <ComObjectTable>
              <!-- Keine geraeteweiten Kommunikationsobjekte: alles haengt am Kanal
                   (Fan.templ.xml). Auch die Gruppen-KOs eines Verbunds liegen am Luefter
                   mit der Rolle Master bzw. Slave, nicht am Verbund. -->
            </ComObjectTable>
          </Static>

          <Dynamic>
            <Channel Id="%AID%_CH-%PREFIX%" Name="Ventilation" Number="%PREFIX%" Icon="windsock" Text="Lüftung">

              <!-- ===== Allgemein ===== -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Lüftersteuerung" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Gerät" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00002_R-%TT%0000201" IndentLevel="1" />
                <ParameterRefRef RefId="%AID%_UP-2000003_R-200000301" IndentLevel="1" />
                <ParameterRefRef RefId="%AID%_UP-2000002_R-200000201" IndentLevel="1" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Die Höhe über Meer geht nur in die Anzeige der absoluten Feuchte in g/kg ein. Der Feuchtevergleich selbst rechnet mit Dampfdrücken und ist höhenunabhängig." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Hinweise" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Wie viele Räume, Lüfter und Verbünde es gibt, steht auf der Seite „Kanalauswahl“." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Das Stellsignal ist bipolar um 5 V: 5,00 V ist Stillstand, 0 V und 10,00 V sind Volllast in je einer Richtung. Ein Kanal, der nicht belegt ist, gibt dauerhaft 5,00 V aus." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Ein Raum trägt Sensoren, Betriebsarten und Bedienung und liefert daraus eine Anforderung. Ein Verbund fasst Lüfter zusammen, die gemeinsam gegenläufig takten. Ein Lüfter gehört zu genau einem Raum und genau einem Verbund — ein Raum kann deshalb auch nur einen Lüfter haben, der mit dem Lüfter eines anderen Raums pendelt." UIHint="Information" />
              </ParameterBlock>

              <!-- ===== Kanalauswahl: alle drei Ebenen auf einer Seite =====
                   Hier wird festgelegt, wie viele Räume, Lüfter und Verbünde es gibt. Die
                   Raum-Parameter stehen in Room.share.xml und tragen deshalb ausgeschriebene
                   Ids (Modultyp 20); %TT% wäre in dieser Datei 30. -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Kanalauswahl" Text="Kanalauswahl" Icon="format-list-bulleted-type" HelpContext="BASE-ChannelSelect">

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Räume" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-2000001_R-200000101" IndentLevel="1" />
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" UIHint="Headline" Text="Raum" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,2" UIHint="Headline" Text="Kanalaktivität" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,3" UIHint="Headline" Text="Beschreibung" />
                </ParameterBlock>
                <op:include href="Room.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="ROOM" IsInner="true" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Lüfter" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" IndentLevel="1" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Die Platine bestimmt, wie viele Lüfterkanäle es gibt. Die Firmware vergleicht die Auswahl beim Start mit der bestückten Platine; bei Abweichung gehen alle Lüfter auf Störung und 5,00 V." UIHint="Information" />
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" UIHint="Headline" Text="Lüfter" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,2" UIHint="Headline" Text="Kanalaktivität" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,3" UIHint="Headline" Text="Beschreibung" />
                </ParameterBlock>
                <op:include href="Fan.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="FAN" IsInner="true" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Verbünde" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00003_R-%TT%0000301" IndentLevel="1" />
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" UIHint="Headline" Text="Verbund" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,2" UIHint="Headline" Text="Rolle" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,3" UIHint="Headline" Text="Beschreibung" />
                </ParameterBlock>
                <op:usePart name="GROUP" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='GroupSettings']/*" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Ein Verbund braucht mindestens einen Lüfter. Verbünde, denen kein Lüfter zugeordnet ist, bleiben wirkungslos." UIHint="Information" />

              </ParameterBlock>

              <!-- ===== Anschluss =====
                   Reine Hinweisseite, keine Parameter. Sie beantwortet die Frage, die am
                   Klemmenblock gestellt wird: welcher Luefter kommt an welche Klemme.

                   Die Zuordnung Luefter -> Kanal ist NICHT in der ETS berechenbar: ein ego
                   belegt zwei Kanaele und verschiebt alle folgenden Luefter. Die ETS kann
                   ueber Kanalgrenzen hinweg nicht rechnen. Deshalb steht hier die Regel,
                   und die tatsaechliche Zuordnung zeigt die Konsole mit "kwl st". -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Wiring" Text="Anschluss" Icon="meter-electric-outline" HelpContext="Empty">

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Klemmenbelegung" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Alle Lüfterklemmen sind gleich belegt:  1 = 12 V  ·  2 = S (Stellsignal)  ·  3 = GND. Die Reihenfolge steht auch im Bestückungsdruck der Platine." UIHint="Information" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanal und Klemme" UIHint="Headline" />
                <choose ParamRefId="%AID%_UP-%TT%00001_R-%TT%0000101">
                  <when test="2">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Entwicklungsaufbau Pico + DFR1073: Kanal 1 = VOUT0, Kanal 2 = VOUT1 des Breakout-Moduls. I²C-Adresse 0x58." UIHint="Information" />

                    <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                      <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                      <Columns><Column Id="%AID%_PB-nnn_C-1" Width="100%" /></Columns>
                      <ParameterRefRef RefId="%AID%_P-%TT%00010_R-%TT%0001001" Cell="1,1" />
                    </ParameterBlock>
                  </when>
                  <when test="4">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="KNXFANDRV Rev 0.1 — vier dreipolige Klemmen, Kanal 1 liegt links außen:" UIHint="Information" />

                    <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                      <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                      <Columns><Column Id="%AID%_PB-nnn_C-1" Width="100%" /></Columns>
                      <ParameterRefRef RefId="%AID%_P-%TT%00011_R-%TT%0001101" Cell="1,1" />
                    </ParameterBlock>
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanal 1  →  Klemme J3  ·  Netz S1  ·  U2 VOUT0 (0x58)" UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanal 2  →  Klemme J4  ·  Netz S2  ·  U2 VOUT1 (0x58)" UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanal 3  →  Klemme J5  ·  Netz S3  ·  U3 VOUT0 (0x59)" UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanal 4  →  Klemme J6  ·  Netz S4  ·  U3 VOUT1 (0x59)" UIHint="Information" />
                  </when>
                  <when default="true">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Für diese Platine steht die Klemmenbeschriftung noch nicht fest. Es gilt: Kanal n liegt auf dem n-ten Ausgang in aufsteigender Reihenfolge der I²C-Adressen, je Chip erst VOUT0, dann VOUT1." UIHint="Information" />
                  </when>
                </choose>

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Welcher Lüfter kommt an welchen Kanal" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Jeder Lüfter nennt seinen Kanal selbst: auf der Lüfterseite unter „Zuordnung“ steht der Parameter „DAC-Kanal“. Vorgabe ist Lüfter n an Kanal n — wer anders verdrahtet hat, stellt es dort um." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Ein LUNOS ego belegt ZWEI aufeinanderfolgende Kanäle und verschiebt damit alle folgenden Lüfter. Beide Motoren müssen auf demselben DAC liegen, damit sie in einem einzigen I²C-Frame gestellt werden — sonst laufen sie beim Richtungswechsel auseinander. Ein ego beginnt deshalb immer auf einem ungeraden Kanal (1, 3, 5 …)." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Beispiel Rev 0.1: Lüfter 1 e²60 auf Kanal 1 (J3), Lüfter 2 e²60 auf Kanal 2 (J4), Lüfter 3 ego auf Kanal 3 — er belegt damit J5 und J6. Ein vierter Lüfter hätte keinen Kanal mehr." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kein Kanal darf doppelt vergeben sein. Die Firmware prüft das beim Start: doppelt belegter Kanal, Kanal jenseits der gewählten Platine oder ein ego auf geradem Kanal ergeben Fehlercode 3 am betroffenen Lüfter, und sein Ausgang bleibt bei 5,00 V." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Die geltende Zuordnung zeigt das Gerät außerdem auf der Konsole mit dem Befehl „kwl st“." UIHint="Information" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Leitung" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Drei Adern genügen: 12 V, Stellsignal S und GND. Die Masse wird sternförmig von der Steuerung aus geführt und nicht von Lüfter zu Lüfter durchgeschleift — jeder Kanal hat dafür sein eigenes Massenetz auf der Platine." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Ohne vierte Ader fließt der Laststrom des Lüfters über dieselbe Masse wie das Stellsignal. Ab etwa 5 m Leitung bei 0,7 mm² verfälscht das die Stellspannung spürbar; dann die Leitungskompensation auf der Lüfterseite einschalten. Mit getrennter vierter Ader als Signalmasse ist sie entbehrlich." UIHint="Information" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Vor dem ersten Einschalten" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Das Stellsignal ist bipolar um 5 V: 5,00 V ist Stillstand, 0 V und 10,00 V sind Volllast in je einer Richtung. Ein Kanal ohne aktiven Lüfter gibt dauerhaft 5,00 V aus." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Die 12 V der Lüfterversorgung sind galvanisch vom KNX getrennt. Diese Trennung nicht durch eine gemeinsame Masse zwischen Bus- und Lüfterseite überbrücken." UIHint="Information" />

              </ParameterBlock>

              <!-- ===== Raumseiten aus dem ROOM-Template ===== -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Rooms" Text="Räume" Icon="thermometer">
                <op:include href="Room.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="ROOM" IsInner="true" />
              </ParameterBlock>

              <!-- ===== Luefterseiten aus dem FAN-Template ===== -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Fans" Text="Lüfter" Icon="windsock">
                <op:include href="Fan.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="FAN" IsInner="true" />
              </ParameterBlock>

              <!-- ===== Verbundseiten ===== -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="GroupsPage" Text="Verbünde" Icon="repeat-variant">
                <op:usePart name="GROUP" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Groups']/*" />
              </ParameterBlock>

            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
